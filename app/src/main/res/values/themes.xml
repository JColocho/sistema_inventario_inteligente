<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- =============================================
     INVENAR — Tema Principal (Dark)
     Base: Theme.MaterialComponents.DayNight.NoActionBar
============================================= -->
    <style name="Theme.Invenar" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Color primario (teal) -->
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryDark">@color/accent_teal_dark</item>
        <item name="colorPrimaryVariant">@color/accent_teal_dark</item>
        <item name="colorOnPrimary">@color/bg_primary</item>

        <!-- Color secundario (morado) -->
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorSecondaryVariant">@color/accent_purple_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Fondos -->
        <item name="android:colorBackground">@color/bg_secondary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>
        <item name="colorOnError">@color/text_primary</item>

        <!-- Status bar y navigation bar -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Elevation / sombras (forzar oscuro) -->
        <item name="elevationOverlayEnabled">true</item>
        <item name="elevationOverlayColor">@color/accent_teal</item>

        <!-- Texto general -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">#1A00D4AA</item>

    </style>

    <!-- =============================================
         TEMA SPLASH SCREEN (sin ActionBar, fondo oscuro)
    ============================================= -->
    <style name="Theme.Invenar.Splash" parent="Theme.Invenar">
        <item name="android:windowBackground">@color/bg_primary</item>
    </style>

    <!-- =============================================
         CARDS — Material Card View
    ============================================= -->
    <style name="Invenar.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_default</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Invenar.Card.Elevated" parent="Invenar.Card">
        <item name="cardBackgroundColor">@color/bg_card_elevated</item>
        <item name="cardElevation">4dp</item>
    </style>

    <!-- Card destacada (Escanear Producto / CTA) -->
    <style name="Invenar.Card.Accent" parent="Invenar.Card">
        <item name="cardBackgroundColor">@color/btn_scan_bg</item>
        <item name="strokeColor">@color/accent_teal_20</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- =============================================
         BOTONES
    ============================================= -->
    <!-- Botón primario (teal relleno) -->
    <style name="Invenar.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_teal</item>
        <item name="android:textColor">@color/bg_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Botón secundario (outline teal) -->
    <style name="Invenar.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_teal</item>
        <item name="android:textColor">@color/accent_teal</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- FAB (+ Agregar) -->
    <style name="Invenar.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/fab_background</item>
        <item name="tint">@color/fab_icon</item>
    </style>

    <!-- =============================================
         BOTTOM NAVIGATION
    ============================================= -->
    <style name="Invenar.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/nav_background</item>
        <item name="itemIconTint">@color/selector_nav_icon</item>
        <item name="itemTextColor">@color/selector_nav_text</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- =============================================
         TEXT INPUT / SEARCH BAR
    ============================================= -->
    <style name="Invenar.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="boxStrokeColor">@color/border_default</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- =============================================
         CHIPS — Categorias y Badges de Stock
    ============================================= -->
    <style name="Invenar.Chip.Base" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textSize">12sp</item>
        <item name="chipCornerRadius">8dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- Chip de categoria activo -->
    <style name="Invenar.Chip.Active" parent="Invenar.Chip.Base">
        <item name="chipBackgroundColor">@color/accent_teal</item>
        <item name="android:textColor">@color/bg_primary</item>
    </style>

    <!-- Chip de categoria inactivo -->
    <style name="Invenar.Chip.Inactive" parent="Invenar.Chip.Base">
        <item name="chipBackgroundColor">@color/bg_card_elevated</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Badge En Stock -->
    <style name="Invenar.Badge.Success" parent="Invenar.Chip.Base">
        <item name="chipBackgroundColor">@color/status_success_10</item>
        <item name="android:textColor">@color/status_success</item>
    </style>

    <!-- Badge Bajo Stock -->
    <style name="Invenar.Badge.Warning" parent="Invenar.Chip.Base">
        <item name="chipBackgroundColor">@color/status_warning_10</item>
        <item name="android:textColor">@color/status_warning</item>
    </style>

    <!-- Badge Agotado / Sin Stock -->
    <style name="Invenar.Badge.Error" parent="Invenar.Chip.Base">
        <item name="chipBackgroundColor">@color/status_error_10</item>
        <item name="android:textColor">@color/status_error</item>
    </style>

    <!-- =============================================
         TIPOGRAFIA
    ============================================= -->
    <!-- Titulo grande (Panel de Control, Inventario) -->
    <style name="Invenar.Text.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Subtitulo seccion (ACCIONES RAPIDAS, SUCURSAL ACTUAL) -->
    <style name="Invenar.Text.SectionLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Numero grande en stats (6, 5, 2, 1) -->
    <style name="Invenar.Text.Stat" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
    </style>

    <!-- Precio de producto -->
    <style name="Invenar.Text.Price" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_price</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Nombre de producto -->
    <style name="Invenar.Text.ProductName" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>