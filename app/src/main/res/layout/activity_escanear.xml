<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ar.EscanearActivity">

    <io.github.sceneview.ar.ARSceneView
        android:id="@+id/arSceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Etiqueta flotante anclada al modelo 3D -->
    <LinearLayout
        android:id="@+id/layoutEtiquetaFlotante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_ar_hud"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEtiquetaNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvEtiquetaPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ar_coord_color"
            android:textSize="12sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Retículo central -->
    <FrameLayout
        android:id="@+id/layoutReticulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible">

        <View
            android:id="@+id/viewReticuloRing"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_reticulo" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ar_hud" />

    </FrameLayout>

    <!-- Lector de diagnóstico — coincidencia en vivo -->
    <TextView
        android:id="@+id/tvDebugScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_ar_hud"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:visibility="gone"
        tools:text="Producto · 73%" />

    <!-- Overlay de carga -->
    <LinearLayout
        android:id="@+id/layoutCargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/ar_coord_color" />

        <TextView
            android:id="@+id/tvCargandoTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Cargando imágenes de referencia..."
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Overlay de ayuda -->
    <LinearLayout
        android:id="@+id/layoutAyuda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvAyudaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvAyudaSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <LinearLayout
            android:id="@+id/layoutTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_ar_hud"
            android:padding="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAyudaContinuar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent"
            app:cornerRadius="999dp" />

    </LinearLayout>

    <!-- ── BARRA SUPERIOR ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnCerrar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ar_hud"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:padding="10dp"
            android:contentDescription="Cerrar AR" />

        <TextView
            android:id="@+id/tvBranchBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_ar_hud"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- HUD coordenadas X/Y/Z -->
        <LinearLayout
            android:id="@+id/rowCoordenadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_ar_hud"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="X" android:textColor="@color/ar_coord_label"
                    android:textSize="9sp" android:letterSpacing="0.15" />
                <TextView android:id="@+id/tvCoordX" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/ar_coord_color"
                    android:textSize="13sp" android:fontFamily="monospace" android:text="0.00" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_marginEnd="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Y" android:textColor="@color/ar_coord_label"
                    android:textSize="9sp" android:letterSpacing="0.15" />
                <TextView android:id="@+id/tvCoordY" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/ar_coord_color"
                    android:textSize="13sp" android:fontFamily="monospace" android:text="0.00" />
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Z" android:textColor="@color/ar_coord_label"
                    android:textSize="9sp" android:letterSpacing="0.15" />
                <TextView android:id="@+id/tvCoordZ" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/ar_coord_color"
                    android:textSize="13sp" android:fontFamily="monospace" android:text="0.00" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ── PANEL INFERIOR ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/cardEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_ar_panel"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEstadoAR"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="BUSCANDO SUPERFICIES..."
                android:textColor="@color/ar_coord_color"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.15" />

            <ImageButton
                android:id="@+id/btnMinimizarPanel"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_chevron_right"
                android:rotation="90"
                android:padding="4dp"
                android:contentDescription="Minimizar panel"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvInstruccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apunta la cámara a una superficie plana"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDimensionesEstante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ar_coord_color"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:visibility="gone" />

        <!-- Sección producto detectado -->
        <LinearLayout
            android:id="@+id/layoutInfoProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ar_divider"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivProductoThumbAR"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="14dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_ar_hud"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProductoNombreAR"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        tools:text="Producto detectado" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvProductoSkuAR"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            tools:text="SKU-001" />

                        <TextView
                            android:id="@+id/tvProductoPrecioAR"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ar_coord_color"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="$299.00" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Fila chips: solo categoría (stock chip removido) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvProductoCategoriaAR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="10sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textColor="@color/ar_coord_label"
                    android:background="@drawable/bg_ar_hud"
                    android:visibility="gone"
                    tools:text="ELECTRÓNICA" />

            </LinearLayout>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerFichaAR"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Ver ficha"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="999dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarInfoAR"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Cerrar"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    app:strokeColor="@color/ar_divider"
                    app:cornerRadius="999dp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
