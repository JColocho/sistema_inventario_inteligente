<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    tools:context=".EditarProductoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/btnEditarBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_img"
                app:srcCompat="@drawable/ic_back_foreground"
                app:tint="@color/accent_teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Editar Producto"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Imagen de referencia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_image_picker"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imgProductoEditar"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:background="@drawable/bg_img"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Imagen de Referencia"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Botones de imagen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUBIR IMAGEN DE REFERENCIA *"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCamaraEditarProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="Abrir Camara"
                app:icon="@drawable/camara"
                app:iconGravity="top"
                app:iconSize="30dp" />

            <Button
                android:id="@+id/btnGaleriaEditarProducto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="Abrir Galeria"
                app:icon="@drawable/galeria_imagenes"
                app:iconGravity="top"
                app:iconSize="30dp" />
        </LinearLayout>

        <!-- Nombre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NOMBRE DEL PRODUCTO *"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtNombreProductoEditar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_teal"
                android:ems="10"
                android:hint="Ej. Laptop ASUS A16"
                android:inputType="text"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Descripción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESCRIPCION *"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/txtDescripcionEditar"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/bg_field_teal"
                android:ems="10"
                android:gravity="start"
                android:hint="Ej. Ryzen 7 7000, RX7000, 16GB RAM"
                android:inputType="text|textMultiLine"
                android:padding="10dp" />
        </LinearLayout>

        <!-- Categoría -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECCIONAR CATEGORIA *"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCategoriaEditar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_teal"
                android:padding="10dp" />

        </LinearLayout>

        <!-- Precio y Cantidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="183dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingRight="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PRECIO *"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtPrecioEditar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_field_teal"
                    android:ems="10"
                    android:hint="$0.00"
                    android:inputType="number|numberDecimal"
                    android:padding="10dp"
                    android:textAlignment="textEnd" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingLeft="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CANTIDAD *"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtCantidadEditar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_field_teal"
                    android:ems="10"
                    android:hint="0"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textAlignment="textEnd" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sucursal (sin cambios) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SELECCIONAR SUCURSAL *"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spSucursalEditar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_field_teal"
                android:padding="10dp" />

        </LinearLayout>

        <!-- Modelo 3D -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MODELO 3D (.glb) *"
                android:textColor="@color/text_secondary"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSeleccionarModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:text="Seleccionar archivo .glb"
                app:icon="@drawable/ic_upload"
                app:iconGravity="textStart" />

            <LinearLayout
                android:id="@+id/layoutModeloSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field_teal"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_upload"
                    app:tint="@color/accent_teal" />

                <TextView
                    android:id="@+id/txtNombreModelo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/btnQuitarModelo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/cruz_roja"
                    app:tint="@color/status_error" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botón actualizar -->
        <Button
            android:id="@+id/btnEditarProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button"
            android:text="ACTUALIZAR PRODUCTO" />

    </LinearLayout>
</ScrollView>